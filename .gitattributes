# Keep the published bytes identical to the source: the bundle, the scripts and
# the markdown all ship with LF, and the tone asset must never be touched.
* text=auto eol=lf
*.ps1 text eol=crlf
*.mjs text eol=lf
*.js text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ogg binary
*.wav binary
*.mp3 binary
